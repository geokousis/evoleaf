{
  "name": "evoleaf-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop wrapper for EvoLeaf using the hosted domain.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.evoleaf.desktop",
    "productName": "EvoLeaf",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "auth-preload.js",
      "auth/**/*",
      "build/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  }
}
