#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TOOLKIT_ROOT="$(realpath "$SCRIPT_DIR/..")"

USER_NAME=${1:-overleaf}
PASSWORD=${2:-}

if [[ -z "$PASSWORD" ]]; then
  echo "Usage: bin/set-basic-auth-password <username> <password>"
  exit 1
fi

HASH=$(openssl passwd -apr1 "$PASSWORD")
printf '%s:%s\n' "$USER_NAME" "$HASH" > "$TOOLKIT_ROOT/config/nginx/overleaf.htpasswd"
chmod 644 "$TOOLKIT_ROOT/config/nginx/overleaf.htpasswd"

echo "Updated basic auth credentials for user '$USER_NAME'."
"$TOOLKIT_ROOT/bin/docker-compose" up -d nginx >/dev/null

echo "Nginx reloaded."
